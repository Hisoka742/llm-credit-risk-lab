# Copy to .env (gitignored) and fill in. Never commit the real file.
# Any OpenAI-compatible endpoint works, for example:
#   OpenRouter: https://openrouter.ai/api/v1      model qwen/qwen-2.5-7b-instruct
#   OpenAI:     https://api.openai.com/v1         model gpt-4o-mini
#   vLLM:       http://localhost:8000/v1          model Qwen/Qwen2.5-7B-Instruct
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-key-here
