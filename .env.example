# Copy to .env (gitignored) and fill in. Never commit the real file.
# Any OpenAI-compatible endpoint works, for example:
#   OpenRouter: https://openrouter.ai/api/v1      model qwen/qwen-2.5-7b-instruct
#   OpenAI:     https://api.openai.com/v1         model gpt-4o-mini
#   vLLM:       http://localhost:8000/v1          model Qwen/Qwen2.5-7B-Instruct
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-key-here

# Live demo (python -m scripts.serve) with GigaChat. The authorization key comes from the
# GigaChat API project page (developers.sber.ru). Fill it in .env only.
GIGACHAT_AUTH_KEY=your-authorization-key-here
# Sber's endpoints use the Russian Trusted Root CA, which is not in the default trust store.
# Download the root certificate (PEM) from gosuslugi.ru/crt and point to the file:
# GIGACHAT_CA_BUNDLE=C:/certs/russian_trusted_root_ca.pem
